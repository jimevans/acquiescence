{
  "name": "acquiescence",
  "version": "0.1.18",
  "description": "Library for querying and waiting for element states, taking and matching accessibility snapshots, taking DOM snapshots, describing elements, and recording user actions",
  "keywords": [
    "accessibility",
    "aria",
    "aria-snapshot",
    "accessible-name",
    "dom-snapshot",
    "element-state",
    "automation",
    "testing",
    "playwright",
    "webdriver"
  ],
  "author": "Jim Evans",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimevans/acquiescence.git"
  },
  "homepage": "https://github.com/jimevans/acquiescence#readme",
  "bugs": {
    "url": "https://github.com/jimevans/acquiescence/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && npm run build:browser",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=Acquiescence --outfile=dist/acquiescence.browser.js --sourcemap",
    "dev": "tsc --project tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:types": "tsc --noEmit",
    "lint:src": "tsc --project tsconfig.build.json --noEmit",
    "lint:eslint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:browser": "vitest run --browser.enabled=true",
    "test:browser:watch": "vitest --browser.enabled=true",
    "test:browser:coverage": "vitest run --browser.enabled=true --coverage",
    "test:browser:ui": "vitest --browser.enabled=true --ui",
    "test:browser:headed": "VITEST_HEADLESS=false vitest run --browser.enabled=true",
    "test:browser:debug": "VITEST_HEADLESS=false vitest --browser.enabled=true --ui",
    "test:browser:chrome": "VITEST_BROWSER=chrome vitest run --browser.enabled=true",
    "test:browser:chrome:watch": "VITEST_BROWSER=chrome vitest --browser.enabled=true",
    "test:browser:chrome:headed": "VITEST_BROWSER=chrome VITEST_HEADLESS=false vitest run --browser.enabled=true",
    "test:browser:firefox": "VITEST_BROWSER=firefox vitest run --browser.enabled=true",
    "test:browser:firefox:watch": "VITEST_BROWSER=firefox vitest --browser.enabled=true",
    "test:browser:firefox:headed": "VITEST_BROWSER=firefox VITEST_HEADLESS=false vitest run --browser.enabled=true",
    "test:browser:safari": "VITEST_BROWSER=safari VITEST_HEADLESS=false vitest run --browser.enabled=true",
    "test:browser:safari:watch": "VITEST_BROWSER=safari VITEST_HEADLESS=false vitest --browser.enabled=true",
    "test:browser:safari:headed": "VITEST_BROWSER=safari VITEST_HEADLESS=false vitest run --browser.enabled=true",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-webdriverio": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2",
    "webdriverio": "^9.32.0"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "^3.2.0"
    }
  }
}
